{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/consultores/evaluar-candidatos",
      "regex": "^/consultores/evaluar\\-candidatos(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/consultores/evaluar\\-candidatos(?:/)?$"
    },
    {
      "page": "/consultores/orden-merito",
      "regex": "^/consultores/orden\\-merito(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/consultores/orden\\-merito(?:/)?$"
    },
    {
      "page": "/consultores/preguntas",
      "regex": "^/consultores/preguntas(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/consultores/preguntas(?:/)?$"
    },
    {
      "page": "/consultores/preguntas/nueva",
      "regex": "^/consultores/preguntas/nueva(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/consultores/preguntas/nueva(?:/)?$"
    },
    {
      "page": "/cuestionario",
      "regex": "^/cuestionario(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/cuestionario(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}