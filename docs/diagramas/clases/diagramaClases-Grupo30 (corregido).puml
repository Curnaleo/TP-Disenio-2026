' ============================================================
' ENUMERACIONES
' ============================================================
enum EstadoCuestionario {
  ACTIVO
  EN_PROCESO
  COMPLETO
  INCOMPLETO
  SIN_CONTESTAR
}

enum TipoDocumento {
  DNI
  LE
  LC
  PP
}

enum Genero {
  H
  M
  X
}

' ============================================================
' ENTIDADES (Modelo de Dominio)
' ============================================================
entity Usuario <<entity>> {
  - idUsuario : Integer
  - nombre : String
  - activo : Boolean
}

entity Candidato <<entity>> {
  - nroCandidato : Integer
  - apellido : String
  - nombre : String
  - nroDocumento : String
  - tipoDocumento : TipoDocumento
  - fechaNacimiento : LocalDate
  - genero : Genero
  - nacionalidad : String
  - email : String
  - escolaridad : String
  - eliminado : Boolean
}

entity Evaluacion <<entity>> {
  - id : Integer
  - nombreEvaluacion : String
  - descripcion : String
  - fechaCreacion : LocalDate
  - activo : Boolean
}

entity Cuestionario <<entity>> {
  - idCuestionario : Integer
  - clave : String
  - estado : EstadoCuestionario
  - fechaHoraInicio : LocalDateTime
  - fechaHoraFin : LocalDateTime
  - fechaHoraUltimoIngreso : LocalDateTime
  - cantidadAccesos : Integer
  - maximoAccesos : Integer
  - tiempoMaximo : Integer
}

entity Puesto <<entity>> {
  - puestoId : Integer
  - codigo : String
  - nombre : String
  - descripcion : String
  - empresa : String
  - activo : Boolean
}

entity CaracteristicaPuesto <<entity>> {
  - id : Integer
  - ponderacionMinima : Double
}

entity Competencia <<entity>> {
  - codigo : String
  - nombre : String
  - descripcion : String
  - activo : Boolean
}

entity Factor <<entity>> {
  - codigo : String
  - nombre : String
  - descripcion : String
  - nroOrden : Integer
  - activo : Boolean
}

entity BloquePreguntas <<entity>> {
  - idBloque : Integer
  - nroBloque : Integer
  - completado : Boolean
}

entity Pregunta <<entity>> {
  - id : Integer
  - nombre : String
  - textoPregunta : String
  - descripcion : String
  - activo : Boolean
}

entity OpcionRespuesta <<entity>> {
  - id : Integer
  - nombre : String
  - descripcion : String
  - activo : Boolean
}

entity ItemOpcionRespuesta <<entity>> {
  - id : Integer
  - orden : Integer
  - descripcion : String
}

entity PreguntaCuestionario <<entity>> {
  - idPregCuest : Integer
  - nroOrden : Integer
  - respondida : Boolean
}

entity ResultadoFactor <<entity>> {
  - idResultadoFactor : Integer
  - puntajeObtenido : Double
}

entity ResultadoCompetencia <<entity>> {
  - idResultadoCompetencia : Integer
  - puntajeObtenido : Double
}

entity RegistroAuditoria <<entity>> {
  - id : Integer
  - fechaHora : LocalDateTime
  - usuario : String
  - accion : String
  - entidad : String
  - idEntidad : Integer
}

entity ConfiguracionSistema <<entity>> {
  - clave : String
  - valor : String
  - descripcion : String
}

entity OpcionPregunta <<entity>> {
  - id : Integer
  - ponderacion : Double
}

