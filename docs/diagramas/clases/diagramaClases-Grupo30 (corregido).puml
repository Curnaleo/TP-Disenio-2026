skinparam classAttributeIconSize 0
skinparam linetype polyline

skinparam classBackgroundColor<<entity>> #FFFFFF
skinparam classBackgroundColor<<dto>> #B0E0E6
skinparam classBackgroundColor<<dao>> #FC8B79
skinparam classBackgroundColor<<service>> #F6D365
skinparam classBackgroundColor<<boundary>> #FFFF99
skinparam classBackgroundColor<<rest>> #DCE9FC
