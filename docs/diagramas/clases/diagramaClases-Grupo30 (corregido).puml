  + actualizar(competencia: Competencia) : void
  + eliminarLogico(codigo: String) : void
  + validarEnUso(codigo: String) : boolean
}

interface IFactorDAO <<dao>> {
  + buscar(comp: String, nombre: String) : List<Factor>
